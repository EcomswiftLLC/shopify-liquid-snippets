{%- comment -%}
  Accessible pagination snippet.

  Usage (inside a paginate block):
    {%- paginate collection.products by 24 -%}
      ... product grid ...
      {%- render 'pagination', paginate: paginate, anchor: '#ProductGrid' -%}
    {%- endpaginate -%}

  Params:
    paginate (object) required - the paginate object
    anchor   (string) optional - appended to every link, e.g. '#ProductGrid'
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" role="navigation" aria-label="Pagination">
    <ul class="pagination__list">
      {%- if paginate.previous -%}
        <li>
          <a class="pagination__link" href="{{ paginate.previous.url }}{{ anchor }}" rel="prev" aria-label="Previous page">Prev</a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__link" href="{{ part.url }}{{ anchor }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span class="pagination__link pagination__link--gap">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a class="pagination__link" href="{{ paginate.next.url }}{{ anchor }}" rel="next" aria-label="Next page">Next</a>
        </li>
      {%- endif -%}
    </ul>

    {%- assign first_item = paginate.current_offset | plus: 1 -%}
    {%- assign last_item = paginate.current_offset | plus: paginate.page_size -%}
    {%- if last_item > paginate.items -%}
      {%- assign last_item = paginate.items -%}
    {%- endif -%}
    <p class="pagination__count">Showing {{ first_item }}-{{ last_item }} of {{ paginate.items }}</p>
  </nav>
{%- endif -%}

<style>
  .pagination { margin: 2rem 0; text-align: center; }
  .pagination__list { display: flex; justify-content: center; gap: .25rem; list-style: none; padding: 0; margin: 0 0 .5rem; }
  .pagination__link { display: grid; place-items: center; min-width: 2.25rem; height: 2.25rem; padding: 0 .5rem; border-radius: 6px; text-decoration: none; color: inherit; }
  .pagination__link:hover { background: #f3f4f6; }
  .pagination__link--current { background: #111827; color: #fff; }
  .pagination__link--gap { pointer-events: none; opacity: .5; }
  .pagination__count { font-size: 12px; color: #6b7280; margin: 0; }
</style>
