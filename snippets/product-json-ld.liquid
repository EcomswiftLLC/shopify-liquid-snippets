{%- comment -%}
  Product structured data (JSON-LD) for Google rich results.
  Render it once near the bottom of sections/main-product.liquid.

  Usage:
    {%- render 'product-json-ld', product: product -%}
{%- endcomment -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | strip_html | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  "url": {{ shop.url | append: product.url | json }},
  "image": [
    {%- assign img_media = product.media | where: 'media_type', 'image' -%}
    {%- for media in img_media limit: 5 -%}
      {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "sku": {{ variant.sku | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "url": {{ shop.url | append: variant.url | json }},
      "itemCondition": "https://schema.org/NewCondition"
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- if product.metafields.reviews.rating_count > 0 -%}
  ,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ product.metafields.reviews.rating.value | json }},
    "reviewCount": {{ product.metafields.reviews.rating_count | json }}
  }
  {%- endif -%}
}
</script>

{%- comment -%}
  Notes
  - Prices must be sent as a decimal, hence divided_by: 100.0
  - Only include aggregateRating when you really have reviews, otherwise Google flags it.
  - Validate with https://search.google.com/test/rich-results
{%- endcomment -%}
